    "homepage": "https://github.com/mkerstner/roundcube-skin-aurora",
    "license": "CC-BY-SA-3.0",
    "authors": [
        {
            "name": "Matthias Kerstner",
            "role": "Lead"
        }
    ],
    "support": {
        "issues": "https://github.com/mkerstner/roundcube-skin-aurora/issues",
        "source": "https://github.com/mkerstner/roundcube-skin-aurora"
    },
    "require": {
        "php": ">=8.1",
        "roundcube/plugin-installer": "~0.3.5"
    },
    "extra": {
        "roundcube": {
            "min-version": "1.7.0"
        }
    }
}
